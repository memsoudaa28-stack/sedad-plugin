{
  "name": "NexConnect Payment",
  "key": "nexconnect",
  "description": "Plugin pour la passerelle de paiement NexConnect - Sedad Bank",
  "version": "1.0.0",
  "author": "Sedad",
  "integration_type": "payment_method",
  "models": [
    {
      "model_name": "Paymethod",
      "name": "NexConnect",
      "gateway": "nexconnect",
      "version": "v1",
      "featured": "[]",
      "data_template": "[{\"name\":\"Logo\",\"key\":\"image\",\"type\":\"image\",\"required\":false,\"default_value\":\"https:sedad-3j5x.onrender.com/images/sedad.jpeg\",\"description\":\"Logo shown at checkout\",\"editable\":false}]",
      "data": "{\"image\":\"https:sedad-3j5x.onrender.com/images/sedad.jpeg\"}"
    }
  ],
  "hooks": [
    {
      "type": "filter",
      "hook": "paymethod_nexconnect_pay",
      "name": "NexConnect payment",
      "description": "Filter for NexConnect payment",
      "path": "/hooks/payments/pay",
      "delay": 0
    },
    {
      "type": "filter",
      "hook": "paymethod_nexconnect_confirm",
      "name": "NexConnect payment confirm",
      "description": "Filter for NexConnect payment confirm",
      "path": "/hooks/payments/confirm",
      "delay": 0
    }
  ],
  "configs": [
    {
      "name": "Token API NexConnect",
      "key": "nexconnect_token",
      "description": "Token d'autorisation Bearer fourni par NexConnect",
      "default_value": "",
      "public": false,
      "type": 7,
      "customizable": false,
      "hidden": false,
      "options": [],
      "can_replaced_by_businesses": true,
      "can_replaced_by_sites": false
    },
    {
      "name": "Code Abonnement",
      "key": "code_abonnement",
      "description": "Code d'abonnement NexConnect",
      "default_value": "",
      "public": false,
      "type": 1,
      "customizable": false,
      "hidden": false,
      "options": [],
      "can_replaced_by_businesses": true,
      "can_replaced_by_sites": false
    },
    {
      "name": "URL API NexConnect",
      "key": "api_url",
      "description": "URL de base de l'API NexConnect",
      "default_value": "https://nexpay-653e0b7d7b24.herokuapp.com",
      "public": false,
      "type": 1,
      "customizable": false,
      "hidden": false,
      "options": [],
      "can_replaced_by_businesses": true,
      "can_replaced_by_sites": false
    },
    {
      "name": "Type Paiement",
      "key": "payment_type",
      "description": "Type de paiement : Wallet ou Carte",
      "default_value": "Wallet",
      "public": false,
      "type": 2,
      "customizable": false,
      "hidden": false,
      "options": [
        { "value": "Wallet", "text": "Wallet" },
        { "value": "Carte", "text": "Carte" }
      ],
      "can_replaced_by_businesses": true,
      "can_replaced_by_sites": false
    }
  ],
  "after_install_url": "https://sedad-3j5x.onrender.com/api/after_install"
}
